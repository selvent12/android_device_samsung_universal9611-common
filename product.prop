## FUSE
persist.sys.fuse.passthrough.enable=true

## APK Verity
ro.apk_verity.mode=2

## Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

## Multi-Gen LRU
persist.device_config.mglru_native.lru_gen_config=core_and_mm_walk

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.dbg.allow_ims_off=1

# ImsMedia: the VoIP route has no CP call gain, compensate digitally
persist.radio.imsmedia.rx_gain_db=6
persist.radio.imsmedia.tx_gain_db=9
