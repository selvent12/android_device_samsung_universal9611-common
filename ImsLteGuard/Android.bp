android_app {
    name: "ImsLteGuard",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp_whitelist_org.lineageos.imslteguard"],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.imslteguard",
    src: "privapp_whitelist_org.lineageos.imslteguard.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}
